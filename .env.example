# ============================================================
# 港大医院投诉管理系统 - 环境变量配置示例
# 版本: v1.0
# 说明: 复制此文件为 .env 并填写实际值
# ============================================================

# ============================================================
# 数据库配置 (Oracle)
# ============================================================
DB_HOST=192.168.1.100
DB_PORT=1521
DB_SERVICE_NAME=ORCL
DB_USERNAME=complaint
# 数据库密码（建议使用Jasypt加密后填入ENC(密文)格式）
DB_PASSWORD=your_plain_password_or_encrypted_password

# ============================================================
# Redis配置
# ============================================================
REDIS_HOST=192.168.1.100
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# ============================================================
# Jasypt加密配置
# ============================================================
# 注意：这个密码非常重要，用于加密敏感配置
# 请使用至少8位的强密码，并妥善保管
JASYPT_ENCRYPTOR_PASSWORD=your_jasypt_encryptor_password

# ============================================================
# JWT配置
# ============================================================
# JWT密钥，请使用至少256位的随机字符串
JWT_SECRET=your_jwt_secret_key_at_least_256_bits_long_for_security_purposes

# ============================================================
# 微信公众号配置
# ============================================================
WECHAT_MP_APP_ID=your_wechat_mp_app_id
WECHAT_MP_APP_SECRET=your_wechat_mp_app_secret
WECHAT_MP_TOKEN=your_wechat_mp_token
WECHAT_MP_AES_KEY=your_wechat_mp_aes_key
WECHAT_H5_BASE_URL=https://m.hkuh.hk

# ============================================================
# 短信服务配置
# ============================================================
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY_ID=your_sms_access_key_id
SMS_ACCESS_KEY_SECRET=your_sms_access_key_secret
SMS_SIGN_NAME=港大医院
# 短信模板ID
SMS_TEMPLATE_COMPLAINT_ACCEPT=SMS_001
SMS_TEMPLATE_COMPLAINT_PROGRESS=SMS_002
SMS_TEMPLATE_COMPLAINT_COMPLETE=SMS_003
SMS_TEMPLATE_SATISFACTION_INVITE=SMS_004
SMS_TEMPLATE_VERIFICATION_CODE=SMS_005

# ============================================================
# 邮件服务配置
# ============================================================
# 邮件发送邮箱
MAIL_USERNAME=complaint@hkuh.edu.cn
MAIL_PASSWORD=your_mail_password
MAIL_HOST=smtp.hkuh.edu.cn
MAIL_PORT=465

# ============================================================
# AES加密配置
# ============================================================
# AES-256-GCM密钥（32字节，Base64编码）
AES_KEY=your_base64_encoded_32_byte_aes_key_here
# AES IV（12字节，Base64编码）
AES_IV=your_base64_encoded_12_byte_iv_here

# ============================================================
# 应用URL配置
# ============================================================
APP_BASE_URL=https://admin.hkuh.hk
APP_ADMIN_URL=https://admin.hkuh.hk
APP_H5_URL=https://m.hkuh.hk

# ============================================================
# 文件上传配置
# ============================================================
UPLOAD_BASE_PATH=/data/complaint/uploads

# ============================================================
# SLA配置（小时）
# ============================================================
SLA_NORMAL_HOURS=72
SLA_URGENT_HOURS=24
SLA_SMS_REMINDER_BEFORE=4
SLA_EMAIL_REMINDER_BEFORE=8

# ============================================================
# Java应用参数
# ============================================================
JAVA_OPTS=-Xms2g -Xmx4g -XX:+UseG1GC
SPRING_PROFILES_ACTIVE=prod
