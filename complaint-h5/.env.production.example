# ============================================================
# H5移动端 - Netlify 生产环境变量配置
# ============================================================

# API后端地址（必填）
# 替换为实际的API服务器地址
VITE_API_BASE_URL=https://your-api-domain.com

# 微信公众号AppID（可选）
VITE_WECHAT_APP_ID=your_wechat_app_id

# 是否启用微信SDK
VITE_ENABLE_WECHAT_SDK=false
